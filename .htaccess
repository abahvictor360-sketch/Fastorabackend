# Laravel expects the web server's document root to be its `public/` folder.
# On hosts that lock the document root to public_html (and deploy the repo
# straight into it), that isn't configurable, so the whole application ends up
# inside the web root with no index.php at the top level, which serves a 403.
#
# This forwards every request into public/ so the app works unchanged, and
# denies direct access to the application files that are now sitting inside
# the web root as a side effect of that layout.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Uploaded media. `php artisan storage:link` points public/storage at
    # storage/app/public with a symlink, but shared hosts frequently disallow
    # symlinks, leaving every image 404ing. Mapping the URL straight onto the
    # real directory works either way. Scoped to app/public, so nothing else
    # under storage/ (logs, cached views, sessions) is reachable.
    #
    # The (?!app/public/) guard is what prevents a loop: the substitution
    # still begins with "storage/", so without it the rule would match its
    # own output until the server gave up with a 500.
    #
    # [L] rather than [END]. [END] would stop rewriting outright, which is
    # tidier, but it is not honoured by every server build and where it is
    # unrecognised the whole rule is skipped, leaving media 404ing. [L] is
    # universally supported, and the guard above plus the /storage/ exclusion
    # on the catch-all below make the restart it causes harmless.
    # A missing media file goes to the app instead of 404ing at the web server.
    # storage/app/public is gitignored, so a deploy that did not run
    # app:sync-media leaves it bare and every image on the site breaks at once.
    # The route this reaches restores the bundled original from
    # database/seeders/images, which is tracked and therefore always present.
    #
    # Deliberately placed before the rule below rather than folded into it as a
    # condition: when the file is there this never matches, so the working path
    # keeps serving statically and is not touched by this addition.
    RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$1 !-f
    RewriteRule ^storage/(?!app/public/)(.*)$ public/index.php [L]

    RewriteRule ^storage/(?!app/public/)(.*)$ storage/app/public/$1 [L]

    # Everything else is a Laravel route, so hand it to public/index.php.
    # /storage/ is excluded because the rule above uses [L], which restarts
    # the ruleset: without this, a media request that has already been mapped
    # onto storage/app/public would come back round and be sent into public/.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/storage/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Never serve dotfiles. .env holds the database password and app key, and a
# git clone may also leave .git/ here.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Project manifests and the CLI entry point are not web resources.
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# No directory listings anywhere above public/.
Options -Indexes
